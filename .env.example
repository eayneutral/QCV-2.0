# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DATABASE_URL: PostgreSQL connection string (NeonDB)
# Example: postgresql://user:password@ep-cool-name-1234.us-east-2.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/qcv"

# JWT_SECRET: Secret key for signing JWT tokens
JWT_SECRET="quantum_vault_super_secret_key_change_in_production"
