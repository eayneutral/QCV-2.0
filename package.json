    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "prisma": "^6.3.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
