generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id               String          @id @default(uuid())
  email            String          @unique
  password         String          // Hashed master password for auth ONLY
  role             String          @default("user")
  subscriptionPlan String          @default("free") // free, pro, team, enterprise
  tenantId         String          @default(uuid())
  createdAt        DateTime        @default(now())
  vaults           Vault[]
  sessions         Session[]
  authenticators   Authenticator[]
  magicLinks       MagicLink[]
  auditLogs        AuditLog[]
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  ip        String?
  device    String?
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Authenticator {
  credentialID         String  @id // Base64URL encoded
  userId               String
  credentialPublicKey  Bytes
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MagicLink {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Vault {
  id            String   @id @default(uuid())
  userId        String
  title         String
  category      String
  tags          String   // Comma separated
  encryptedData String   // AES-256-GCM encrypted blob
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions      VaultVersion[]
}

model VaultVersion {
  id            String   @id @default(uuid())
  vaultId       String
  encryptedData String
  createdAt     DateTime @default(now())
  vault         Vault    @relation(fields: [vaultId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RecoveryCode {
  id        String   @id @default(uuid())
  userId    String
  code      String   // Hashed recovery code
  used      Boolean  @default(false)
}

model GlobalSetting {
  key   String @id
  value String // JSON string for complex objects
}

model CustomRole {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions String   // JSON array of permissions e.g., ["read:vault", "write:vault", "manage:users"]
  description String?
  createdAt   DateTime @default(now())
}



